{
  "expo": {
    "name": "Major Flyer",
    "slug": "major-flyer",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080C22",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.abqlab.majorflyer",
      "supportsTablet": true,
      "requireFullScreen": true
    },
    "android": {
      "package": "com.abqlab.majorflyer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080C22"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#080C22"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6744388004633498~5213266367",
          "iosAppId": "ca-app-pub-6744388004633498~9033091878"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.21"
          }
        }
      ]
    ]
  }
}
