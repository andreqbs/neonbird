# Copie para .env e troque a senha ANTES de subir.
#
#   cp .env.example .env
#
# O .env nao vai para o git (ver .gitignore). Senha boa aqui e uma senha que
# ninguem digita nem decora — gere uma:
#
#   openssl rand -base64 24

POSTGRES_USER=majorflyer
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=majorflyer

# Porta em que a API responde na VPS. Com um proxy na frente, troque a linha
# "ports" do docker-compose.yml por 127.0.0.1:8080:8080 e deixe o HTTPS com ele.
API_PORT=8080

# Quem pode chamar a API pelo NAVEGADOR (a versao web do jogo). O aplicativo
# nativo nem passa por aqui. "*" serve porque a identificacao vai em cabecalho,
# nao em cookie: nao ha sessao de navegador para roubar.
ALLOWED_ORIGINS=*

# Ligue (true) somente se houver nginx/Caddy/Traefik na frente. Ele faz o
# servidor confiar no cabecalho X-Forwarded-For para saber de quem e o pedido —
# exposto direto na internet, isso deixaria qualquer um forjar o proprio IP e
# escapar do limite de pedidos.
TRUST_PROXY=false

# Teto de pontos por partida. O jogo termina na fase 5, no obstaculo 500; o
# valor e folgado de proposito e serve so para barrar o absurdo.
MAX_RUN_POINTS=2000

# Piso de tempo por ponto, em segundos. No celular, um obstaculo leva ~2,1 s na
# fase 1 e ~1,3 s na fase 5 para chegar ao passaro; placar feito mais rapido que
# isto e recusado (sem moedas e sem ranking).
MIN_SECONDS_PER_POINT=1.0

# Partida aberta ha mais tempo que isto (em minutos) nao fecha mais.
MAX_RUN_MINUTES=180

# SO PARA SERVIDOR DE DESENVOLVIMENTO. Anuncio de teste e anuncio simulado nao
# geram o aviso do Google, entao para testar os premios no `expo start` o
# servidor precisa aceita-los sem o aviso. No servidor do app publicado fica
# false: ligado, qualquer um ganha premio sem assistir nada.
ADS_DEV_AUTOVERIFY=false

# Verificacao de integridade das partidas (Play Integrity) — ver o README:
#   off      nao verifica (desenvolvimento)
#   log      verifica e grava o resultado na partida, sem barrar nada
#   enforce  partida sem verificacao valida nao rende moedas nem ranking
# Ligada (log ou enforce), precisa da chave JSON da conta de servico do Google
# Cloud, inteira ou em base64. NUNCA commite essa chave.
INTEGRITY_MODE=off
GOOGLE_SERVICE_ACCOUNT=

# Limite de pedidos por IP (balde que enche sozinho).
RATE_PER_MINUTE=120
RATE_BURST=40
